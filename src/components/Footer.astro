---
const year = new Date().getFullYear();
---
<footer class="site-footer" transition:persist="site-footer">
  <div class="max-w-6xl mx-auto px-lg py-3xl flex flex-col md:flex-row md:items-start md:justify-between gap-xl">
    <div class="flex flex-col gap-sm max-w-prose">
      <a href="/" class="site-brand flex items-center gap-sm">
        <img
          src="/brand/logo.jpeg"
          alt=""
          width="32"
          height="32"
          class="site-brand-logo site-brand-logo--sm"
        />
        <span class="font-display text-lg text-ink">Saanvika Solar Systems</span>
      </a>
      <p class="text-sm">Born in Kakinada. Built for coastal Andhra homes.</p>
      <p class="text-xs leading-relaxed">
        Serving Kakinada and the wider APEPDCL circle — rooftop surveys, PM Surya Ghar paperwork, and net metering done local.
      </p>
    </div>
    <nav>
      <ul class="flex flex-col gap-sm text-sm">
        <li><a href="/about">About</a></li>
        <li><a href="/services">Services</a></li>
        <li><a href="/faq">FAQ</a></li>
        <li><a href="/contact">Contact</a></li>
      </ul>
    </nav>
  </div>
  <div class="max-w-6xl mx-auto px-lg pb-xl flex flex-col sm:flex-row sm:items-center sm:justify-between gap-sm text-xs">
    <p>© {year} Saanvika Solar Systems. All rights reserved.</p>
    <a href="/ops/login" class="footer-staff-login">Staff login</a>
  </div>
</footer>
