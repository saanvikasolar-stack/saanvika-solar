---
import Layout from "../layouts/Layout.astro";
import { queryAboutContent } from "../lib/about";

const about = await queryAboutContent();

const heading =
  about?.heading?.trim() ||
  "Saanvika Solar Systems — from Kakinada rooftops to APEPDCL meters";

const bodyHtml =
  about?.bodyHtml?.trim() ||
  `<p>We grew up under Godavari coast sun — the kind that cooks terrace floors by noon and sends summer APEPDCL bills climbing every month. Saanvika Solar Systems is a local PM Surya Ghar MNRE vendor based in Kakinada: site survey, panel layout, net metering paperwork, and the install crew that shows up when they say they will.</p>
<p>No Hyderabad sales script. Plain talk about unit rates, subsidy stages, and what your roof can actually carry. From Suryaraopeta flats to coastal houses facing the bay breeze, we size systems for real Kakinada heat — not brochure numbers.</p>
<p>When the panels are up and the bi-directional meter is live, you watch units reverse on the bill. That is the whole point. Call us for a free site survey if you are ready to stop paying peak summer rates for nothing.</p>`;

const cmsImageUrl = about?.imageUrl;
---

<Layout
  title="About"
  description="Saanvika Solar Systems — Kakinada rooftop solar, PM Surya Ghar MNRE vendor. Local crew for APEPDCL net metering and Godavari coast homes."
>
  <section class="about-hero relative overflow-hidden">
    <div
      class="about-hero-glow"
      aria-hidden="true"
      data-decorative-slot="cmsHeader"
      style="background-color: var(--color-paper-warm);"
    ></div>

    <div class="max-w-6xl mx-auto px-lg py-3xl md:py-4xl relative">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-2xl md:gap-3xl items-center">
        <div class="flex flex-col gap-lg about-hero-copy">
          <div class="flex items-center gap-md">
            <img
              src="/brand/logo.jpeg"
              alt="Saanvika Solar Systems"
              width="72"
              height="72"
              class="about-brand-mark rounded-md"
            />
            <p class="font-display text-sm tracking-wide uppercase text-mute">
              Saanvika Solar Systems
            </p>
          </div>
          <h1 class="font-display text-4xl md:text-5xl leading-tight text-ink">
            {heading}
          </h1>
          <p class="text-lg text-ink-soft max-w-prose leading-relaxed">
            Rooftop solar for Kakinada homes — PM Surya Ghar paperwork, APEPDCL net metering, and installs that hold up in coastal heat.
          </p>
        </div>

        <div class="relative about-visual-wrap">
          {
            cmsImageUrl ? (
              <div
                class="about-visual rounded-md overflow-hidden"
                data-decorative-slot="about"
                style={`aspect-ratio: 4/3; background-color: var(--color-paper-warm);`}
              >
                <img
                  src={cmsImageUrl}
                  alt=""
                  class="w-full h-full object-cover"
                  loading="lazy"
                />
              </div>
            ) : (
              <div
                class="about-visual about-themed-block rounded-md"
                data-decorative-slot="about"
                style="aspect-ratio: 4/3; background-color: var(--color-paper-warm);"
                aria-hidden="true"
              >
                <div class="about-themed-sun"></div>
                <div class="about-themed-panel about-themed-panel-a"></div>
                <div class="about-themed-panel about-themed-panel-b"></div>
                <div class="about-themed-panel about-themed-panel-c"></div>
                <span class="about-themed-caption font-display">Godavari coast sun</span>
              </div>
            )
          }
        </div>
      </div>
    </div>
  </section>

  <section class="about-body bg-paper">
    <div class="container-reading px-lg py-3xl md:py-4xl">
      <hr class="editorial-rule w-16 ml-0" />
      <div class="about-prose text-ink leading-relaxed flex flex-col gap-md" set:html={bodyHtml} />
      <div class="mt-2xl flex flex-wrap gap-md">
        <a href="/contact" class="btn-primary">Talk to our Kakinada team</a>
        <a href="/faq" class="btn-secondary">Subsidy &amp; net metering FAQ</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .about-hero {
    background:
      radial-gradient(ellipse 80% 60% at 85% 20%, color-mix(in srgb, var(--color-cream) 70%, transparent), transparent 55%),
      linear-gradient(165deg, var(--color-paper) 0%, var(--color-paper-warm) 100%);
  }

  .about-hero-glow {
    position: absolute;
    inset: auto -10% -20% auto;
    width: min(48vw, 28rem);
    height: min(48vw, 28rem);
    border-radius: 50%;
    opacity: 0.45;
    background:
      radial-gradient(circle, color-mix(in srgb, var(--color-accent) 28%, transparent), transparent 68%);
    pointer-events: none;
  }

  .about-hero-copy {
    animation: about-rise 700ms ease both;
  }

  .about-brand-mark {
    width: 4.5rem;
    height: 4.5rem;
    object-fit: cover;
    border: 1px solid var(--color-rule);
    box-shadow: 0 8px 24px color-mix(in srgb, var(--color-ink) 8%, transparent);
  }

  .about-visual-wrap {
    animation: about-rise 700ms ease 120ms both;
  }

  .about-themed-block {
    position: relative;
    overflow: hidden;
    background:
      linear-gradient(145deg, var(--color-ink) 0%, var(--color-ink-soft) 55%, var(--color-paper-warm) 100%);
  }

  .about-themed-sun {
    position: absolute;
    top: 12%;
    right: 14%;
    width: 28%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, var(--color-cream), var(--color-accent) 70%);
    animation: about-sun-pulse 4.5s ease-in-out infinite;
  }

  .about-themed-panel {
    position: absolute;
    left: 10%;
    height: 14%;
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--color-paper) 22%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-cream) 35%, transparent);
    transform: skewX(-12deg);
  }

  .about-themed-panel-a {
    bottom: 38%;
    width: 58%;
  }

  .about-themed-panel-b {
    bottom: 22%;
    width: 64%;
    opacity: 0.85;
  }

  .about-themed-panel-c {
    bottom: 8%;
    width: 50%;
    opacity: 0.7;
  }

  .about-themed-caption {
    position: absolute;
    left: var(--spacing-md);
    top: var(--spacing-md);
    color: var(--color-cream);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.85;
  }

  .about-prose :global(p + p) {
    margin-top: var(--spacing-md);
  }

  .about-prose :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  @keyframes about-rise {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes about-sun-pulse {
    0%,
    100% {
      transform: scale(1);
      filter: brightness(1);
    }
    50% {
      transform: scale(1.06);
      filter: brightness(1.08);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .about-hero-copy,
    .about-visual-wrap,
    .about-themed-sun {
      animation: none;
    }
  }
</style>
