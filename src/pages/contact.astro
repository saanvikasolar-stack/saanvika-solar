---
import Layout from "../layouts/Layout.astro";
import { forms } from "@wix/forms";
import { auth } from "@wix/essentials";
import ContactForm from "../components/ContactForm.tsx";

const SEEDED_FORM_ID = "aaef6134-892f-4141-87ff-3dd5cf8b02bc";

let formId = "";
let formFields: {
  label: string;
  target: string;
  required: boolean;
  componentType: string;
  identifier: string;
  options?: { value: string; label: string }[];
}[] = [];

try {
  const elevatedListForms = auth.elevate(forms.listForms);
  const listResult = await elevatedListForms("wix.form_app.form");
  const listed = listResult.forms ?? [];
  const wixForm =
    listed.find((f) => f._id === SEEDED_FORM_ID) ?? listed[0];
  formId = wixForm?._id ?? "";

  formFields =
    wixForm?.formFields
      ?.filter((field) => field.fieldType === "INPUT" && !field.hidden)
      .map((field) => {
        const opts = field.inputOptions;
        const str = opts?.stringOptions;
        const label =
          str?.textInputOptions?.label ??
          str?.dropdownOptions?.label ??
          str?.phoneInputOptions?.label ??
          "";
        return {
          label,
          target: opts?.target ?? "",
          required: opts?.required ?? false,
          componentType: str?.componentType ?? "TEXT_INPUT",
          identifier: field.identifier ?? "",
          options: str?.dropdownOptions?.options?.map((o) => ({
            value: o.value ?? o.label ?? "",
            label: o.label ?? o.value ?? "",
          })),
        };
      }) ?? [];
} catch (err) {
  console.error("[forms] listForms failed:", err);
}
---

<Layout
  title="Contact"
  description="Tell Saanvika Solar Systems about your Kakinada rooftop — monthly bill, roof notes, and mobile number. We'll call you back."
>
  <section class="contact-hero relative overflow-hidden">
    <div class="contact-hero-blocks" aria-hidden="true">
      <span class="themed-block themed-block--sun"></span>
      <span class="themed-block themed-block--panel"></span>
      <span class="themed-block themed-block--navy"></span>
      <span class="themed-block themed-block--warm"></span>
    </div>
    <div class="relative max-w-6xl mx-auto px-lg py-3xl md:py-4xl">
      <p class="font-display text-sm tracking-[0.14em] uppercase text-accent mb-md">
        Saanvika Solar Systems
      </p>
      <h1 class="font-display text-4xl md:text-5xl leading-tight text-ink max-w-prose">
        Talk to us about your rooftop
      </h1>
      <p class="mt-md text-lg text-mute max-w-prose">
        Share your mobile number, monthly bill, and a few roof notes — our
        Kakinada team will call you back.
      </p>
    </div>
  </section>

  <section class="contact-cta max-w-6xl mx-auto px-lg pb-4xl">
    <div class="contact-layout">
      <div class="contact-form-col">
        <hr class="editorial-rule w-16 ml-0 mt-0 mb-lg" />
        <h2 class="font-display text-2xl md:text-3xl text-ink mb-sm">
          Send a message
        </h2>
        <p class="text-mute mb-xl max-w-prose">
          No long forms — just enough for us to prepare a rough rooftop estimate
          before we ring you.
        </p>

        {formId ? (
          <ContactForm client:load formId={formId} fields={formFields} />
        ) : (
          <p class="text-mute">
            No form found. Create one in the Wix dashboard, then refresh this page.
          </p>
        )}
      </div>

      <aside class="contact-aside">
        <div class="contact-aside-blocks" aria-hidden="true">
          <span class="aside-tile aside-tile--a"></span>
          <span class="aside-tile aside-tile--b"></span>
          <span class="aside-tile aside-tile--c"></span>
        </div>
        <div class="contact-aside-copy">
          <h3 class="font-display text-xl text-ink">Serving Kakinada homes</h3>
          <p class="text-mute mt-sm">
            Free site survey across Kakinada and nearby coastal Andhra. We handle
            APEPDCL net metering and PM Surya Ghar paperwork with you.
          </p>
          <ul class="contact-meta mt-lg">
            <li>
              <span class="contact-meta-label">Hours</span>
              <span>Mon–Sat, 9:30 am – 6:30 pm</span>
            </li>
            <li>
              <span class="contact-meta-label">Area</span>
              <span>Kakinada · East Godavari</span>
            </li>
            <li>
              <span class="contact-meta-label">What to share</span>
              <span>Mobile number, monthly bill, roof facing / size</span>
            </li>
          </ul>
        </div>
      </aside>
    </div>
  </section>
</Layout>

<style>
  .contact-hero {
    background:
      linear-gradient(
        135deg,
        var(--color-paper) 0%,
        var(--color-cream) 42%,
        var(--color-paper-warm) 100%
      );
    border-bottom: 1px solid var(--color-rule);
  }

  .contact-hero-blocks {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .themed-block {
    position: absolute;
    border-radius: var(--radius-md);
    opacity: 0.9;
  }

  .themed-block--sun {
    width: min(28vw, 11rem);
    aspect-ratio: 1;
    top: 12%;
    right: 8%;
    background: radial-gradient(
      circle at 35% 35%,
      color-mix(in srgb, var(--color-accent) 85%, white),
      var(--color-accent) 70%
    );
    animation: block-rise 1.1s ease-out both;
  }

  .themed-block--panel {
    width: min(34vw, 14rem);
    height: min(18vw, 7.5rem);
    bottom: 10%;
    right: 18%;
    background:
      repeating-linear-gradient(
        90deg,
        color-mix(in srgb, var(--color-ink) 72%, #3a7ca5) 0 18%,
        color-mix(in srgb, var(--color-ink) 55%, #5ba3c9) 18% 22%
      );
    transform: skewX(-8deg);
    animation: block-rise 1.1s ease-out 120ms both;
  }

  .themed-block--navy {
    width: min(16vw, 5.5rem);
    height: min(22vw, 8rem);
    top: 28%;
    right: 32%;
    background: var(--color-ink);
    opacity: 0.12;
    animation: block-rise 1.1s ease-out 200ms both;
  }

  .themed-block--warm {
    width: min(20vw, 7rem);
    height: min(12vw, 4rem);
    bottom: 22%;
    right: 6%;
    background: var(--color-paper-warm);
    border: 1px solid var(--color-rule);
    animation: block-rise 1.1s ease-out 280ms both;
  }

  @keyframes block-rise {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 0.9;
      transform: translateY(0);
    }
  }

  .contact-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-3xl);
    align-items: start;
  }

  @media (min-width: 900px) {
    .contact-layout {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      gap: var(--spacing-4xl);
    }

    .themed-block--sun {
      animation: block-rise 1.1s ease-out both, sun-glow 4.5s ease-in-out 1.2s infinite;
    }
  }

  @keyframes sun-glow {
    0%,
    100% {
      filter: brightness(1);
    }
    50% {
      filter: brightness(1.08);
    }
  }

  .contact-aside {
    position: relative;
    background: var(--color-paper-warm);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-lg);
    overflow: hidden;
    padding: var(--spacing-xl);
  }

  .contact-aside-blocks {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    grid-template-rows: 4.5rem 3rem;
    gap: var(--spacing-xs);
    margin-bottom: var(--spacing-lg);
  }

  .aside-tile {
    border-radius: var(--radius-sm);
  }

  .aside-tile--a {
    background: linear-gradient(
      135deg,
      var(--color-accent),
      color-mix(in srgb, var(--color-accent) 60%, var(--color-cream))
    );
    grid-row: 1 / 3;
    animation: tile-in 700ms ease-out both;
  }

  .aside-tile--b {
    background: var(--color-ink);
    animation: tile-in 700ms ease-out 80ms both;
  }

  .aside-tile--c {
    background:
      repeating-linear-gradient(
        90deg,
        #2f6f92 0 28%,
        #4a93b8 28% 34%
      );
    animation: tile-in 700ms ease-out 140ms both;
  }

  @keyframes tile-in {
    from {
      opacity: 0;
      transform: scale(0.96);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  .contact-meta {
    display: grid;
    gap: var(--spacing-md);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .contact-meta li {
    display: grid;
    gap: var(--spacing-2xs);
    padding-top: var(--spacing-md);
    border-top: 1px solid var(--color-rule);
    font-size: 0.9375rem;
    color: var(--color-ink-soft);
  }

  .contact-meta-label {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-mute);
  }

  @media (max-width: 640px) {
    .themed-block--panel,
    .themed-block--navy,
    .themed-block--warm {
      opacity: 0.55;
    }

    .themed-block--sun {
      width: 5.5rem;
      right: 4%;
      top: 8%;
    }
  }
</style>

<style is:global>
  /* Form island styles also live in components-forms.css (Layout import).
     Kept here so React-rendered inputs stay visible if that import changes. */
  .form-container {
    display: grid;
    gap: var(--spacing-md, 1.25rem);
    max-width: var(--container-prose, 42rem);
    width: 100%;
  }
  .form-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-md, 1.25rem);
  }
  @media (min-width: 640px) {
    .form-row {
      grid-template-columns: 1fr 1fr;
    }
  }
  .form-field {
    display: grid;
    gap: var(--spacing-2xs, 0.25rem);
  }
  .form-label {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-ink);
  }
  .form-label .required {
    color: var(--color-accent);
    margin-left: 0.15em;
  }
  .form-input,
  .form-select,
  .form-textarea {
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-md, 0.5rem);
    padding: var(--spacing-sm) var(--spacing-md);
    background: var(--color-paper);
    color: var(--color-ink);
    font: inherit;
    width: 100%;
  }
  .form-input:focus,
  .form-select:focus,
  .form-textarea:focus {
    outline: none;
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-accent) 22%, transparent);
  }
  .form-textarea {
    min-height: 7.5rem;
    resize: vertical;
  }
  .form-input-error {
    border-color: var(--color-error, var(--color-accent)) !important;
  }
  .form-field-error {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--color-error, var(--color-accent));
  }
  .form-button {
    background: var(--color-accent);
    color: #fff;
    border: 0;
    border-radius: var(--radius-md);
    padding: var(--spacing-sm) var(--spacing-lg);
    font-weight: 600;
    font-family: var(--font-body);
    cursor: pointer;
    justify-self: start;
  }
  .form-button:hover:not(:disabled) {
    filter: brightness(1.05);
  }
  .form-button:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }
  .form-success {
    display: grid;
    gap: var(--spacing-sm);
    padding: var(--spacing-xl);
    background: var(--color-cream, var(--color-paper-warm));
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-md);
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: 1.25rem;
    line-height: 1.35;
    max-width: var(--container-prose, 42rem);
  }
  .form-success-note {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--color-mute);
    font-weight: 400;
  }
  .form-error {
    margin: 0;
    color: var(--color-error, var(--color-accent));
    font-size: 0.9375rem;
  }
</style>
