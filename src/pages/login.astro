---
import { resolveOpsSession } from "../lib/ops-auth";

const session = await resolveOpsSession();
if (session) {
  return Astro.redirect("/ops/index.html", 302);
}
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex,nofollow" />
  <link rel="icon" href="/brand/logo.jpeg" />
  <title>Staff sign-in — Saanvika Solar Systems</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;600;700&family=Fraunces:opsz,wght@9..144,600;9..144,700&display=swap" rel="stylesheet" />
  <style>
    :root {
      --ink: #14231a;
      --muted: #4d6356;
      --leaf: #1f6b45;
      --leaf-deep: #0f3d28;
      --sand: #e8f0ea;
      --sun: #f0b429;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      min-height: 100vh;
      font-family: "DM Sans", sans-serif;
      color: var(--ink);
      background:
        radial-gradient(1200px 600px at 10% -10%, rgba(240,180,41,0.28), transparent 55%),
        radial-gradient(900px 500px at 100% 0%, rgba(31,107,69,0.22), transparent 50%),
        linear-gradient(165deg, #f7fbf8 0%, #e4efe8 45%, #d8e8de 100%);
      display: grid;
      place-items: center;
      padding: 24px;
    }
    .card {
      width: min(440px, 100%);
      background: rgba(255,255,255,0.86);
      backdrop-filter: blur(10px);
      border: 1px solid rgba(20,35,26,0.08);
      border-radius: 20px;
      padding: 36px 32px 28px;
      box-shadow: 0 24px 60px rgba(15,61,40,0.12);
    }
    .brand {
      display: flex;
      align-items: center;
      gap: 14px;
      margin-bottom: 28px;
    }
    .brand img {
      width: 52px;
      height: 52px;
      border-radius: 50%;
      object-fit: cover;
      border: 2px solid rgba(31,107,69,0.25);
    }
    .brand h1 {
      margin: 0;
      font-family: Fraunces, Georgia, serif;
      font-size: 1.35rem;
      line-height: 1.2;
      letter-spacing: -0.02em;
    }
    .brand p {
      margin: 4px 0 0;
      color: var(--muted);
      font-size: 0.92rem;
    }
    h2 {
      margin: 0 0 8px;
      font-family: Fraunces, Georgia, serif;
      font-size: 1.55rem;
      letter-spacing: -0.02em;
    }
    .lead {
      margin: 0 0 24px;
      color: var(--muted);
      line-height: 1.5;
      font-size: 0.98rem;
    }
    .cta {
      display: block;
      width: 100%;
      text-align: center;
      text-decoration: none;
      background: linear-gradient(135deg, var(--leaf) 0%, var(--leaf-deep) 100%);
      color: #fff;
      font-weight: 700;
      padding: 14px 18px;
      border-radius: 12px;
      border: none;
      cursor: pointer;
      font-size: 1rem;
      transition: transform 0.15s ease, box-shadow 0.15s ease;
      box-shadow: 0 10px 24px rgba(15,61,40,0.22);
    }
    .cta:hover { transform: translateY(-1px); }
    .note {
      margin: 18px 0 0;
      font-size: 0.85rem;
      color: var(--muted);
      line-height: 1.45;
    }
    .note strong { color: var(--ink); }
    .locks {
      margin-top: 22px;
      padding-top: 18px;
      border-top: 1px solid rgba(20,35,26,0.08);
      display: grid;
      gap: 10px;
      font-size: 0.82rem;
      color: var(--muted);
    }
    .locks span { display: flex; gap: 8px; align-items: flex-start; }
    .dot {
      width: 8px; height: 8px; border-radius: 50%;
      background: var(--leaf); margin-top: 5px; flex: none;
    }
  </style>
</head>
<body>
  <main class="card">
    <div class="brand">
      <img src="/brand/logo.jpeg" alt="Saanvika Solar Systems" width="52" height="52" />
      <div>
        <h1>Saanvika Solar Systems</h1>
        <p>Staff operations · Kakinada</p>
      </div>
    </div>
    <h2>Secure staff sign-in</h2>
    <p class="lead">
      Customer and project data stays on Wix with encrypted member passwords —
      not in the browser. Only people on your staff list can open the dashboard.
    </p>
    <a class="cta" href="/api/auth/login?returnToUrl=/ops">Sign in with Wix</a>
    <p class="note">
      First time? Check <strong>boddu.vinod789@gmail.com</strong> for a set-password email from Wix,
      then sign in here. Owner can invite Prem, Rohit, and others by email from inside the dashboard.
    </p>
    <div class="locks">
      <span><i class="dot"></i> HTTPS + Wix-managed member sessions (HttpOnly cookies)</span>
      <span><i class="dot"></i> Ops data in ADMIN-only CMS — never public, never in plaintext passwords</span>
      <span><i class="dot"></i> Staff allowlist by email — random sign-ups cannot see your data</span>
    </div>
  </main>
</body>
</html>
