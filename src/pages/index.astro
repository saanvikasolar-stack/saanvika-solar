---
import Layout from '../layouts/Layout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { services } from '@wix/bookings';
import { auth } from '@wix/essentials';

let homeServices: any[] = [];
try {
  const result = await auth.elevate(services.queryServices)().limit(100).find();
  const all = (result.items ?? []).filter((s: any) => !s.hidden);
  const getSlug = (s: any): string => s.mainSlug?.name ?? s.supportedSlugs?.[0]?.name ?? s._id;
  // Free Site Survey first, then up to 3 total for the teaser.
  homeServices = [...all]
    .sort((a, b) => {
      const rank = (s: any) => (getSlug(s) === 'free-site-survey' ? 0 : 1);
      return rank(a) - rank(b);
    })
    .slice(0, 3);
} catch (err) {
  console.error('[home:bookings] services query failed:', err);
}

const getSlug = (s: any): string => s.mainSlug?.name ?? s.supportedSlugs?.[0]?.name ?? s._id;
const formatPrice = (s: any): string | undefined => {
  const p = s.payment;
  if (!p || p.rateType === 'NO_FEE') return 'Free';
  if (p.rateType === 'FIXED' && p.fixed?.price) {
    const { value, currency } = p.fixed.price;
    if (!value || Number(value) === 0) return 'Free';
    return new Intl.NumberFormat('en-IN', { style: 'currency', currency: currency ?? 'INR' }).format(Number(value));
  }
  return undefined;
};
const getDuration = (s: any): number => s.schedule?.availabilityConstraints?.sessionDurations?.[0] ?? 60;
---
<Layout
  title="Rooftop solar for Kakinada"
  description="Saanvika Solar Systems — Kakinada rooftop solar, PM Surya Ghar subsidy, APEPDCL net metering. Book a free site survey."
>
  <!-- Hero: one composition, brand-first -->
  <section class="home-hero relative overflow-hidden">
    <div class="home-hero-wash" aria-hidden="true"></div>
    <div class="max-w-6xl mx-auto px-lg py-3xl md:py-4xl relative">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-2xl md:gap-3xl items-center">
        <div class="flex flex-col gap-lg home-hero-copy">
          <img
            src="/brand/logo.jpeg"
            alt="Saanvika Solar Systems"
            width="88"
            height="88"
            class="home-hero-logo"
          />
          <h1 class="font-display text-4xl md:text-5xl leading-tight">
            Rooftop solar, built for Kakinada heat.
          </h1>
          <p class="text-lg text-mute max-w-prose home-hero-lede">
            Godavari coast sun is fierce — we size panels for real terrace heat, APEPDCL bills, and PM Surya Ghar subsidy paperwork you do not want to chase alone.
          </p>
          <div class="flex flex-wrap gap-md items-center">
            <a href="/services/free-site-survey" class="btn-primary">Book free site survey</a>
            <a href="#subsidy" class="btn-secondary">See how subsidy works</a>
          </div>
        </div>
        <div
          class="hero-visual rounded-md"
          data-decorative-slot="hero"
          aria-hidden="true"
        >
          <!-- orchestrator injects <img src={decorativeImages.hero} …> here -->
          <div class="hero-geo"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust strip — below the fold -->
  <section class="trust-strip border-y border-rule" aria-label="Our track record">
    <div class="max-w-6xl mx-auto px-lg py-2xl">
      <p class="text-xs uppercase tracking-widest text-mute mb-lg">Numbers from our Kakinada work</p>
      <dl class="trust-grid">
        <div class="trust-stat">
          <dt class="trust-num">296</dt>
          <dd class="trust-label">rooftops installed</dd>
        </div>
        <div class="trust-stat">
          <dt class="trust-num">373</dt>
          <dd class="trust-label">PM Surya Ghar apps</dd>
        </div>
        <div class="trust-stat">
          <dt class="trust-num">290</dt>
          <dd class="trust-label">subsidies redeemed</dd>
        </div>
        <div class="trust-stat">
          <dt class="trust-num">292</dt>
          <dd class="trust-label">inspections cleared</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- PM Surya Ghar subsidy -->
  <section id="subsidy" class="max-w-6xl mx-auto px-lg py-4xl scroll-mt-24">
    <header class="flex flex-col gap-md max-w-prose mb-2xl">
      <hr class="editorial-rule w-16 ml-0 accent-underline" />
      <h2 class="font-display text-3xl md:text-4xl leading-tight">PM Surya Ghar subsidy, plain talk</h2>
      <p class="text-mute leading-relaxed">
        Central subsidy for residential rooftop — the money lands after your system is live and paperwork clears. We handle the forms; you keep the bill drop.
      </p>
    </header>
    <div class="subsidy-grid">
      <div class="subsidy-row">
        <span class="subsidy-tier font-display">First 2 kW</span>
        <span class="subsidy-amount">₹30,000 / kW</span>
        <span class="subsidy-note text-mute text-sm">Up to ₹60,000 on a 2 kW system</span>
      </div>
      <div class="subsidy-row">
        <span class="subsidy-tier font-display">Next 1 kW</span>
        <span class="subsidy-amount">₹18,000 / kW</span>
        <span class="subsidy-note text-mute text-sm">Adds ₹18,000 for going to 3 kW</span>
      </div>
      <div class="subsidy-row subsidy-row--cap">
        <span class="subsidy-tier font-display">Maximum</span>
        <span class="subsidy-amount">₹78,000</span>
        <span class="subsidy-note text-mute text-sm">Cap for systems 3 kW and above</span>
      </div>
    </div>
    <p class="text-sm text-mute mt-xl max-w-prose">
      Example: a typical 3 kW Kakinada home gets ₹60k + ₹18k = ₹78k subsidy. We file the PM Surya Ghar application and walk the APEPDCL net-metering steps with you.
    </p>
  </section>

  <!-- Bill / savings calculator -->
  <section class="calc-section bg-paper-warm border-y border-rule" aria-labelledby="calc-heading">
    <div class="max-w-6xl mx-auto px-lg py-4xl">
      <header class="flex flex-col gap-md max-w-prose mb-2xl">
        <hr class="editorial-rule w-16 ml-0 accent-underline" />
        <h2 id="calc-heading" class="font-display text-3xl md:text-4xl leading-tight">Rough savings from your bill</h2>
        <p class="text-mute leading-relaxed">
          Drag your monthly APEPDCL bill — we sketch system size, subsidy, and payback. Exact numbers come after a free site survey.
        </p>
      </header>
      <div class="calc-block" data-bill-calc>
        <label class="calc-label" for="bill-slider">
          Monthly electricity bill
          <span class="calc-bill-value" data-bill-display>₹3,000</span>
        </label>
        <input
          id="bill-slider"
          class="calc-slider"
          type="range"
          min="1000"
          max="12000"
          step="500"
          value="3000"
          data-bill-input
        />
        <div class="calc-results">
          <div class="calc-result">
            <span class="calc-result-label">Suggested size</span>
            <span class="calc-result-value font-display" data-calc-kw>~3 kW</span>
          </div>
          <div class="calc-result">
            <span class="calc-result-label">Est. subsidy</span>
            <span class="calc-result-value font-display" data-calc-subsidy>₹78,000</span>
          </div>
          <div class="calc-result">
            <span class="calc-result-label">Rough payback</span>
            <span class="calc-result-value font-display" data-calc-payback>~4 yrs</span>
          </div>
        </div>
        <p class="text-xs text-mute mt-md">
          Ballpark only — assumes ~₹6–7/unit, coastal Andhra sun, and standard PM Surya Ghar rates. Site survey locks the real quote.
        </p>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="max-w-6xl mx-auto px-lg py-4xl">
    <header class="flex flex-col gap-md max-w-prose mb-2xl">
      <hr class="editorial-rule w-16 ml-0 accent-underline" />
      <h2 class="font-display text-3xl md:text-4xl leading-tight">How it works in Kakinada</h2>
      <p class="text-mute leading-relaxed">
        Four clear steps — from terrace visit to the meter running backwards on your APEPDCL bill.
      </p>
    </header>
    <ol class="steps-list">
      <li class="step-item">
        <span class="step-num font-display" aria-hidden="true">01</span>
        <div>
          <h3 class="font-display text-xl">Free site survey</h3>
          <p class="text-mute text-sm leading-relaxed mt-xs">
            We climb your terrace, check shade and structure, and talk through your summer load — no charge, no pressure.
          </p>
        </div>
      </li>
      <li class="step-item">
        <span class="step-num font-display" aria-hidden="true">02</span>
        <div>
          <h3 class="font-display text-xl">Design + subsidy</h3>
          <p class="text-mute text-sm leading-relaxed mt-xs">
            Panel layout sized for your roof, PM Surya Ghar application filed, and APEPDCL net-metering paperwork started.
          </p>
        </div>
      </li>
      <li class="step-item">
        <span class="step-num font-display" aria-hidden="true">03</span>
        <div>
          <h3 class="font-display text-xl">Install</h3>
          <p class="text-mute text-sm leading-relaxed mt-xs">
            Local crew mounts panels and inverter — tidy wiring, safety clearances, and a clean finish for coastal weather.
          </p>
        </div>
      </li>
      <li class="step-item">
        <span class="step-num font-display" aria-hidden="true">04</span>
        <div>
          <h3 class="font-display text-xl">Meter runs back</h3>
          <p class="text-mute text-sm leading-relaxed mt-xs">
            Bi-directional meter goes live with APEPDCL. Daytime generation offsets your bill — that is when the savings stick.
          </p>
        </div>
      </li>
    </ol>
  </section>

  <!-- home:bookings -->
  <section class="max-w-6xl mx-auto px-lg py-4xl">
    <header class="flex flex-col gap-md max-w-prose mb-3xl">
      <hr class="editorial-rule w-16 ml-0" />
      <h2 class="font-display text-3xl md:text-4xl leading-tight">Start with a free site survey</h2>
      <p class="text-mute leading-relaxed">
        Book a rooftop visit in Kakinada — shade check, panel layout, and a clear path to subsidy and net metering. No charge, no pressure.
      </p>
    </header>
    {
      homeServices.length === 0 ? (
        <p class="text-mute mb-xl">
          Survey booking opens soon.{' '}
          <a href="/services" class="text-ink underline hover:text-accent">View all services</a>
        </p>
      ) : (
        <div class="service-grid mb-3xl">
          {homeServices.map((s) => (
            <ServiceCard
              id={s._id}
              slug={getSlug(s)}
              name={s.name ?? 'Untitled'}
              tagLine={s.tagLine ?? s.description}
              durationMinutes={getDuration(s)}
              price={formatPrice(s)}
              imageUrl={s.media?.mainMedia?.image?.url ?? s.media?.items?.[0]?.image?.url}
              type={s.type ?? 'APPOINTMENT'}
            />
          ))}
        </div>
      )
    }
    <div class="flex flex-wrap gap-md items-center">
      <a href="/services/free-site-survey" class="btn-primary">Book free site survey</a>
      <a href="/services" class="btn-secondary">View all services</a>
    </div>
  </section>

  <!-- About teaser -->
  <section class="max-w-6xl mx-auto px-lg py-4xl grid grid-cols-1 md:grid-cols-2 gap-3xl items-center">
    <div
      class="about-image rounded-md order-last md:order-first"
      data-decorative-slot="about"
      style="aspect-ratio: 4/3; background-color: var(--color-paper-warm);"
    >
      <!-- orchestrator injects <img src={decorativeImages.about} …> here -->
    </div>
    <div class="flex flex-col gap-md max-w-prose">
      <hr class="editorial-rule w-16 ml-0" />
      <h2 class="font-display text-3xl leading-tight">Local crew. Kakinada roofs.</h2>
      <p class="text-ink leading-relaxed">
        We grew up under Godavari coast sun — the kind that cooks terrace floors by noon and sends summer APEPDCL bills climbing. Saanvika is a PM Surya Ghar MNRE vendor based right here in Kakinada, not a call centre reading a Hyderabad script.
      </p>
      <p class="text-mute leading-relaxed">
        Plain talk on unit rates, subsidy stages, and what your roof can actually carry. From Suryaraopeta flats to houses catching the bay breeze, we size for real heat.
      </p>
      <a href="/about" class="btn-secondary self-start mt-sm">About Saanvika</a>
    </div>
  </section>
</Layout>

<style>
  .home-hero {
    background:
      radial-gradient(ellipse 80% 60% at 10% 0%, color-mix(in srgb, var(--color-cream) 70%, transparent), transparent 55%),
      radial-gradient(ellipse 50% 40% at 90% 20%, color-mix(in srgb, var(--color-accent) 12%, transparent), transparent 50%),
      var(--color-paper);
  }
  .home-hero-wash {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(135deg, transparent 60%, color-mix(in srgb, var(--color-ink) 4%, transparent) 100%);
  }
  .home-hero-logo {
    width: 5.5rem;
    height: 5.5rem;
    object-fit: contain;
    border-radius: var(--radius-md);
  }
  .home-hero-copy {
    animation: fade-up 0.7s ease both;
  }
  .home-hero-lede {
    animation: fade-up 0.7s ease 0.1s both;
  }
  .hero-visual {
    position: relative;
    aspect-ratio: 4 / 5;
    min-height: 16rem;
    background: linear-gradient(
      160deg,
      var(--color-ink) 0%,
      color-mix(in srgb, var(--color-ink) 78%, var(--color-accent)) 48%,
      var(--color-accent) 100%
    );
    overflow: hidden;
  }
  .hero-geo {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(45deg, transparent 40%, color-mix(in srgb, var(--color-cream) 18%, transparent) 40.5%, transparent 41%),
      linear-gradient(-25deg, transparent 55%, color-mix(in srgb, var(--color-paper) 12%, transparent) 55.5%, transparent 56%),
      radial-gradient(circle at 72% 28%, color-mix(in srgb, var(--color-cream) 45%, transparent) 0%, transparent 42%),
      repeating-linear-gradient(
        -18deg,
        transparent,
        transparent 18px,
        color-mix(in srgb, var(--color-paper) 8%, transparent) 18px,
        color-mix(in srgb, var(--color-paper) 8%, transparent) 19px
      );
    animation: geo-drift 14s ease-in-out infinite alternate;
  }
  .hero-visual > img {
    position: relative;
    z-index: 1;
  }

  .trust-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-xl) var(--spacing-lg);
  }
  @media (min-width: 768px) {
    .trust-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .trust-num {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 2.75rem);
    line-height: 1;
    color: var(--color-ink);
    letter-spacing: -0.02em;
  }
  .trust-label {
    margin-top: var(--spacing-xs);
    font-size: 0.875rem;
    color: var(--color-mute);
  }

  .subsidy-grid {
    display: flex;
    flex-direction: column;
    gap: 0;
    border-top: 1px solid var(--color-rule);
  }
  .subsidy-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-2xs);
    padding-block: var(--spacing-lg);
    border-bottom: 1px solid var(--color-rule);
  }
  @media (min-width: 640px) {
    .subsidy-row {
      grid-template-columns: 10rem 10rem 1fr;
      align-items: baseline;
      gap: var(--spacing-lg);
    }
  }
  .subsidy-amount {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--color-accent);
  }
  .subsidy-row--cap .subsidy-amount {
    color: var(--color-ink);
  }

  .calc-block {
    max-width: var(--container-md);
    padding: var(--spacing-xl);
    background: var(--color-paper);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-md);
  }
  .calc-label {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--spacing-md);
    font-size: 0.9375rem;
    color: var(--color-ink-soft);
    margin-bottom: var(--spacing-md);
  }
  .calc-bill-value {
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--color-ink);
  }
  .calc-slider {
    width: 100%;
    accent-color: var(--color-accent);
    margin-bottom: var(--spacing-xl);
  }
  .calc-results {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-lg);
  }
  @media (min-width: 640px) {
    .calc-results {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .calc-result-label {
    display: block;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-mute);
    margin-bottom: var(--spacing-2xs);
  }
  .calc-result-value {
    font-size: 1.5rem;
    color: var(--color-ink);
  }

  .steps-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-xl);
  }
  @media (min-width: 768px) {
    .steps-list {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--spacing-2xl) var(--spacing-xl);
    }
  }
  .step-item {
    display: flex;
    gap: var(--spacing-md);
    align-items: flex-start;
  }
  .step-num {
    flex-shrink: 0;
    font-size: 1.25rem;
    color: var(--color-accent);
    line-height: 1.2;
    min-width: 2rem;
  }

  @keyframes geo-drift {
    from { transform: scale(1) translate(0, 0); }
    to { transform: scale(1.04) translate(-1.5%, 1%); }
  }
</style>

<script>
  function estimateFromBill(bill: number) {
    // Rough: ~₹1,000/month ≈ 1 kW for coastal Andhra residential.
    const kwRaw = Math.max(1, Math.min(10, bill / 1000));
    const kw = Math.round(kwRaw * 2) / 2; // nearest 0.5
    let subsidy = 0;
    if (kw <= 2) subsidy = kw * 30000;
    else if (kw <= 3) subsidy = 2 * 30000 + (kw - 2) * 18000;
    else subsidy = 78000;
    // Net cost rough: ~₹55k/kW after subsidy floor; payback vs annual bill.
    const gross = kw * 55000;
    const net = Math.max(gross - subsidy, gross * 0.35);
    const annualSave = bill * 12 * 0.75;
    const payback = annualSave > 0 ? Math.max(2, Math.round((net / annualSave) * 10) / 10) : 0;
    return { kw, subsidy, payback };
  }

  function formatInr(n: number) {
    return new Intl.NumberFormat('en-IN', {
      style: 'currency',
      currency: 'INR',
      maximumFractionDigits: 0,
    }).format(n);
  }

  function syncCalc(root: HTMLElement) {
    const input = root.querySelector<HTMLInputElement>('[data-bill-input]');
    const billDisplay = root.querySelector<HTMLElement>('[data-bill-display]');
    const kwEl = root.querySelector<HTMLElement>('[data-calc-kw]');
    const subEl = root.querySelector<HTMLElement>('[data-calc-subsidy]');
    const payEl = root.querySelector<HTMLElement>('[data-calc-payback]');
    if (!input || !billDisplay || !kwEl || !subEl || !payEl) return;

    const update = () => {
      const bill = Number(input.value) || 3000;
      const { kw, subsidy, payback } = estimateFromBill(bill);
      billDisplay.textContent = formatInr(bill);
      kwEl.textContent = `~${kw} kW`;
      subEl.textContent = formatInr(subsidy);
      payEl.textContent = `~${payback} yrs`;
    };

    input.addEventListener('input', update);
    update();
  }

  function initCalcs() {
    document.querySelectorAll<HTMLElement>('[data-bill-calc]').forEach(syncCalc);
  }

  initCalcs();
  document.addEventListener('astro:page-load', initCalcs);
</script>
