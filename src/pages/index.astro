---
import Layout from '../layouts/Layout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { services } from '@wix/bookings';
import { auth } from '@wix/essentials';

let homeServices: any[] = [];
try {
  const result = await auth.elevate(services.queryServices)().limit(100).find();
  const all = (result.items ?? []).filter((s: any) => !s.hidden);
  const getSlug = (s: any): string => s.mainSlug?.name ?? s.supportedSlugs?.[0]?.name ?? s._id;
  homeServices = [...all]
    .sort((a, b) => {
      const rank = (s: any) => (getSlug(s) === 'free-site-survey' ? 0 : 1);
      return rank(a) - rank(b);
    })
    .slice(0, 3);
} catch (err) {
  console.error('[home:bookings] services query failed:', err);
}

const getSlug = (s: any): string => s.mainSlug?.name ?? s.supportedSlugs?.[0]?.name ?? s._id;
const formatPrice = (s: any): string | undefined => {
  const p = s.payment;
  if (!p || p.rateType === 'NO_FEE') return 'Free';
  if (p.rateType === 'FIXED' && p.fixed?.price) {
    const { value, currency } = p.fixed.price;
    if (!value || Number(value) === 0) return 'Free';
    return new Intl.NumberFormat('en-IN', { style: 'currency', currency: currency ?? 'INR' }).format(Number(value));
  }
  return undefined;
};
const getDuration = (s: any): number => s.schedule?.availabilityConstraints?.sessionDurations?.[0] ?? 60;
---
<Layout>
  <section class="hero-band relative overflow-hidden">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="max-w-6xl mx-auto px-lg py-4xl grid grid-cols-1 md:grid-cols-2 gap-3xl items-center">
      <div class="flex flex-col gap-lg hero-copy">
        <img
          src="/brand/logo.jpeg"
          alt="Saanvika Solar Systems"
          width="72"
          height="72"
          class="brand-mark"
        />
        <p class="eyebrow">Kakinada · PM Surya Ghar MNRE vendor</p>
        <h1 class="font-display text-4xl md:text-5xl leading-tight">
          Rooftop solar, built for Kakinada heat.
        </h1>
        <p class="text-lg text-mute max-w-prose">
          When the APEPDCL bill climbs every summer, your roof can push back. We design, install,
          file the subsidy, and get your net meter moving — the way a neighbour from here would.
        </p>
        <div class="flex flex-wrap gap-md items-center">
          <a href="/services/free-site-survey" class="btn-primary">Book free site survey</a>
          <a href="#subsidy" class="btn-secondary">See how subsidy works</a>
        </div>
      </div>
      <div
        class="hero-visual rounded-md"
        data-decorative-slot="hero"
        aria-hidden="true"
      >
        <div class="sun-burst"></div>
        <div class="panel-grid"></div>
      </div>
    </div>
  </section>

  <section class="trust-strip border-y border-rule bg-paper-warm/40">
    <div class="max-w-6xl mx-auto px-lg py-2xl grid grid-cols-2 md:grid-cols-4 gap-xl">
      <div>
        <p class="font-display text-3xl text-accent">296</p>
        <p class="text-sm text-mute">Rooftop systems installed</p>
      </div>
      <div>
        <p class="font-display text-3xl text-accent">373</p>
        <p class="text-sm text-mute">PM Surya Ghar applications</p>
      </div>
      <div>
        <p class="font-display text-3xl text-accent">290</p>
        <p class="text-sm text-mute">Subsidies redeemed</p>
      </div>
      <div>
        <p class="font-display text-3xl text-accent">292</p>
        <p class="text-sm text-mute">Site inspections approved</p>
      </div>
    </div>
  </section>

  <section id="subsidy" class="max-w-6xl mx-auto px-lg py-4xl">
    <header class="flex flex-col gap-md max-w-prose mb-3xl">
      <hr class="editorial-rule w-16 ml-0" />
      <h2 class="font-display text-3xl md:text-4xl leading-tight">Your PM Surya Ghar subsidy, explained</h2>
      <p class="text-mute leading-relaxed">
        Under the Central Government scheme, homeowners get direct support — we file every paper
        with the portal and APEPDCL so you don’t chase offices in the heat.
      </p>
    </header>
    <div class="subsidy-grid">
      <div>
        <p class="font-display text-2xl text-ink">₹30,000 / kW</p>
        <p class="text-sm text-mute">First 2 kW</p>
      </div>
      <div>
        <p class="font-display text-2xl text-ink">₹18,000 / kW</p>
        <p class="text-sm text-mute">Next 1 kW</p>
      </div>
      <div>
        <p class="font-display text-2xl text-accent">₹78,000</p>
        <p class="text-sm text-mute">Max for systems above 3 kW</p>
      </div>
    </div>
  </section>

  <section class="calc-band bg-ink text-cream">
    <div class="max-w-6xl mx-auto px-lg py-4xl grid grid-cols-1 md:grid-cols-2 gap-3xl items-center">
      <div class="flex flex-col gap-md max-w-prose">
        <hr class="editorial-rule w-16 ml-0 border-accent" />
        <h2 class="font-display text-3xl leading-tight text-cream">What could your bill save?</h2>
        <p class="text-cream/80 leading-relaxed">
          Drag your typical monthly APEPDCL bill. We’ll sketch a system size, subsidy, and rough
          payback for a clear Kakinada day — confirm exact numbers on the free survey.
        </p>
      </div>
      <div class="calc-panel">
        <label for="billRange" class="text-sm text-cream/80">Monthly electricity bill (₹)</label>
        <input id="billRange" type="range" min="1000" max="15000" step="500" value="5000" />
        <p class="font-display text-3xl" id="billValue">₹5,000 / month</p>
        <dl class="calc-results">
          <div><dt>Est. system</dt><dd id="estKw">3.5 kW</dd></div>
          <div><dt>Est. subsidy</dt><dd id="estSubsidy">₹78,000</dd></div>
          <div><dt>Rough payback</dt><dd id="estPayback">~4.5 yrs</dd></div>
        </dl>
        <a href="/services/free-site-survey" class="btn-primary mt-md">Book free site survey</a>
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-lg py-4xl">
    <header class="flex flex-col gap-md max-w-prose mb-3xl">
      <hr class="editorial-rule w-16 ml-0" />
      <h2 class="font-display text-3xl md:text-4xl leading-tight">Four steps. Then the meter runs back.</h2>
      <p class="text-mute leading-relaxed">From the first rooftop visit in Kakinada to APEPDCL net metering — we stay on it.</p>
    </header>
    <ol class="steps">
      <li><span class="step-num">01</span><div><h3 class="font-display text-xl">Free site survey</h3><p class="text-mute text-sm">Shade, structure, and bill check on your roof.</p></div></li>
      <li><span class="step-num">02</span><div><h3 class="font-display text-xl">Design + subsidy filing</h3><p class="text-mute text-sm">Custom layout and 100% PM Surya Ghar paperwork.</p></div></li>
      <li><span class="step-num">03</span><div><h3 class="font-display text-xl">Install in a few days</h3><p class="text-mute text-sm">Certified crew, careful mounting, clean handover.</p></div></li>
      <li><span class="step-num">04</span><div><h3 class="font-display text-xl">Net meter &amp; savings</h3><p class="text-mute text-sm">APEPDCL credits for units you send back to the grid.</p></div></li>
    </ol>
  </section>

  <!-- home:bookings -->
  <section class="max-w-6xl mx-auto px-lg py-4xl">
    <header class="flex flex-col gap-md max-w-prose mb-3xl">
      <hr class="editorial-rule w-16 ml-0" />
      <h2 class="font-display text-3xl md:text-4xl leading-tight">Start with a free site survey</h2>
      <p class="text-mute leading-relaxed">
        Book a rooftop visit in Kakinada — shade check, panel layout, and a clear path to subsidy and net metering. No charge, no pressure.
      </p>
    </header>
    {
      homeServices.length === 0 ? (
        <p class="text-mute mb-xl">
          Survey booking opens soon.{' '}
          <a href="/services" class="text-ink underline hover:text-accent">View all services</a>
        </p>
      ) : (
        <div class="service-grid mb-3xl">
          {homeServices.map((s) => (
            <ServiceCard
              id={s._id}
              slug={getSlug(s)}
              name={s.name ?? 'Untitled'}
              tagLine={s.tagLine ?? s.description}
              durationMinutes={getDuration(s)}
              price={formatPrice(s)}
              imageUrl={s.media?.mainMedia?.image?.url ?? s.media?.items?.[0]?.image?.url}
              type={s.type ?? 'APPOINTMENT'}
            />
          ))}
        </div>
      )
    }
    <div class="flex flex-wrap gap-md items-center">
      <a href="/services/free-site-survey" class="btn-primary">Book free site survey</a>
      <a href="/services" class="btn-secondary">View all services</a>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-lg py-4xl grid grid-cols-1 md:grid-cols-2 gap-3xl items-center">
    <div
      class="about-image rounded-md order-last md:order-first about-visual"
      data-decorative-slot="about"
      aria-hidden="true"
    ></div>
    <div class="flex flex-col gap-md max-w-prose">
      <hr class="editorial-rule w-16 ml-0" />
      <h2 class="font-display text-3xl leading-tight">Local crew. Local promise.</h2>
      <p class="text-ink leading-relaxed">
        Saanvika Solar Systems grew up with Kakinada’s sun — Godavari-coast heat, summer load, and
        the paperwork maze that keeps good roofs waiting. We’re a registered PM Surya Ghar vendor
        who stays until subsidy and inspection are done.
      </p>
      <p class="text-mute leading-relaxed">
        No Hyderabad call-centre runaround. You get people who know APEPDCL lanes and your street’s
        afternoon glare.
      </p>
      <a href="/about" class="btn-secondary self-start">Our Kakinada story</a>
    </div>
  </section>
</Layout>

<script>
  function subsidyForKw(kw: number) {
    if (kw <= 0) return 0;
    const first = Math.min(kw, 2) * 30000;
    const next = Math.min(Math.max(kw - 2, 0), 1) * 18000;
    return Math.min(first + next, 78000);
  }

  function updateCalc() {
    const input = document.getElementById('billRange') as HTMLInputElement | null;
    if (!input) return;
    const bill = Number(input.value);
    const kw = Math.max(1, Math.min(10, Math.round((bill / 1400) * 10) / 10));
    const subsidy = subsidyForKw(kw);
    const annualSave = bill * 12 * 0.85;
    const netCost = Math.max(kw * 55000 - subsidy, 1);
    const payback = Math.max(2, Math.round((netCost / annualSave) * 10) / 10);

    const billValue = document.getElementById('billValue');
    const estKw = document.getElementById('estKw');
    const estSubsidy = document.getElementById('estSubsidy');
    const estPayback = document.getElementById('estPayback');
    if (billValue) billValue.textContent = `₹${bill.toLocaleString('en-IN')} / month`;
    if (estKw) estKw.textContent = `${kw} kW`;
    if (estSubsidy) estSubsidy.textContent = `₹${subsidy.toLocaleString('en-IN')}`;
    if (estPayback) estPayback.textContent = `~${payback} yrs`;
  }

  const range = document.getElementById('billRange');
  range?.addEventListener('input', updateCalc);
  updateCalc();
</script>

<style>
  .brand-mark {
    border-radius: 9999px;
    object-fit: cover;
    box-shadow: 0 10px 30px -12px rgb(13 44 68 / 35%);
    animation: fade-up 0.7s ease both;
  }
  .eyebrow {
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-mute);
    font-weight: 600;
  }
  .hero-copy > * {
    animation: fade-up 0.7s ease both;
  }
  .hero-copy > *:nth-child(2) { animation-delay: 0.05s; }
  .hero-copy > *:nth-child(3) { animation-delay: 0.1s; }
  .hero-copy > *:nth-child(4) { animation-delay: 0.15s; }
  .hero-copy > *:nth-child(5) { animation-delay: 0.2s; }

  .hero-band {
    background:
      radial-gradient(1200px 500px at 85% 10%, color-mix(in oklab, var(--color-accent) 18%, transparent), transparent 60%),
      linear-gradient(180deg, var(--color-paper) 0%, var(--color-paper-warm) 100%);
  }
  .hero-visual {
    position: relative;
    aspect-ratio: 4 / 5;
    background:
      linear-gradient(145deg, var(--color-ink) 0%, #163652 55%, color-mix(in oklab, var(--color-accent) 55%, #163652) 100%);
    overflow: hidden;
    animation: fade-up 0.8s ease both 0.1s;
  }
  .sun-burst {
    position: absolute;
    right: -10%;
    top: -8%;
    width: 70%;
    aspect-ratio: 1;
    border-radius: 9999px;
    background: radial-gradient(circle at center, var(--color-accent) 0%, color-mix(in oklab, var(--color-accent) 55%, transparent) 55%, transparent 70%);
    animation: sun-pulse 4s ease-in-out infinite;
  }
  .panel-grid {
    position: absolute;
    inset: auto 12% 12% 12%;
    height: 38%;
    background:
      linear-gradient(var(--color-rule) 1px, transparent 1px) 0 0 / 24px 24px,
      linear-gradient(90deg, var(--color-rule) 1px, transparent 1px) 0 0 / 24px 24px,
      color-mix(in oklab, #1A8BD1 55%, white);
    border-radius: 0.5rem;
    opacity: 0.9;
    transform: perspective(600px) rotateX(18deg);
  }
  .about-visual {
    aspect-ratio: 4 / 3;
    background:
      linear-gradient(135deg, var(--color-paper-warm), color-mix(in oklab, var(--color-accent) 20%, var(--color-paper))),
      repeating-linear-gradient(-18deg, transparent, transparent 12px, color-mix(in oklab, var(--color-ink) 6%, transparent) 12px, color-mix(in oklab, var(--color-ink) 6%, transparent) 13px);
  }
  .subsidy-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--spacing-xl);
  }
  @media (max-width: 768px) {
    .subsidy-grid { grid-template-columns: 1fr; }
  }
  .calc-panel {
    background: color-mix(in oklab, white 8%, transparent);
    border: 1px solid color-mix(in oklab, white 18%, transparent);
    border-radius: var(--radius-lg);
    padding: var(--spacing-xl);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }
  .calc-panel input[type="range"] {
    width: 100%;
    accent-color: var(--color-accent);
  }
  .calc-results {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--spacing-md);
  }
  .calc-results dt {
    font-size: 0.75rem;
    color: color-mix(in oklab, var(--color-cream) 70%, transparent);
  }
  .calc-results dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.15rem;
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--spacing-lg);
  }
  .steps li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--spacing-md);
    align-items: start;
    padding-bottom: var(--spacing-md);
    border-bottom: 1px solid var(--color-rule);
  }
  .step-num {
    font-family: var(--font-display);
    color: var(--color-accent);
    font-size: 1.25rem;
  }
  @keyframes fade-up {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes sun-pulse {
    0%, 100% { transform: scale(1); opacity: 0.95; }
    50% { transform: scale(1.04); opacity: 1; }
  }
</style>
