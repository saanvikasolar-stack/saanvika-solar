---
import Layout from '../layouts/Layout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { services } from '@wix/bookings';
import { auth } from '@wix/essentials';

let homeServices: any[] = [];
try {
  const result = await auth.elevate(services.queryServices)().limit(100).find();
  const all = (result.items ?? []).filter((s: any) => !s.hidden);
  const getSlug = (s: any): string => s.mainSlug?.name ?? s.supportedSlugs?.[0]?.name ?? s._id;
  // Free Site Survey first, then up to 3 total for the teaser.
  homeServices = [...all]
    .sort((a, b) => {
      const rank = (s: any) => (getSlug(s) === 'free-site-survey' ? 0 : 1);
      return rank(a) - rank(b);
    })
    .slice(0, 3);
} catch (err) {
  console.error('[home:bookings] services query failed:', err);
}

const getSlug = (s: any): string => s.mainSlug?.name ?? s.supportedSlugs?.[0]?.name ?? s._id;
const formatPrice = (s: any): string | undefined => {
  const p = s.payment;
  if (!p || p.rateType === 'NO_FEE') return 'Free';
  if (p.rateType === 'FIXED' && p.fixed?.price) {
    const { value, currency } = p.fixed.price;
    if (!value || Number(value) === 0) return 'Free';
    return new Intl.NumberFormat('en-IN', { style: 'currency', currency: currency ?? 'INR' }).format(Number(value));
  }
  return undefined;
};
const getDuration = (s: any): number => s.schedule?.availabilityConstraints?.sessionDurations?.[0] ?? 60;
---
<Layout>
  <section class="relative">
    <div class="max-w-6xl mx-auto px-lg py-4xl grid grid-cols-1 md:grid-cols-2 gap-3xl items-center">
      <div class="flex flex-col gap-lg">
        <h1 class="font-display text-4xl md:text-5xl leading-tight">Rooftop solar, built for Kakinada heat.</h1>
        <p class="text-lg text-mute max-w-prose">Registered PM Surya Ghar vendor — design, install, APEPDCL net metering, and subsidy paperwork handled end to end.</p>
      </div>
      <div
        class="hero-image rounded-md"
        data-decorative-slot="hero"
        style="aspect-ratio: 4/5; background-color: var(--color-paper-warm);"
      >
        <!-- orchestrator injects <img src={decorativeImages.hero} …> here -->
      </div>
    </div>
  </section>
  <!-- home:bookings -->
  <section class="max-w-6xl mx-auto px-lg py-4xl">
    <header class="flex flex-col gap-md max-w-prose mb-3xl">
      <hr class="editorial-rule w-16 ml-0" />
      <h2 class="font-display text-3xl md:text-4xl leading-tight">Start with a free site survey</h2>
      <p class="text-mute leading-relaxed">
        Book a rooftop visit in Kakinada — shade check, panel layout, and a clear path to subsidy and net metering. No charge, no pressure.
      </p>
    </header>
    {
      homeServices.length === 0 ? (
        <p class="text-mute mb-xl">
          Survey booking opens soon.{' '}
          <a href="/services" class="text-ink underline hover:text-accent">View all services</a>
        </p>
      ) : (
        <div class="service-grid mb-3xl">
          {homeServices.map((s) => (
            <ServiceCard
              id={s._id}
              slug={getSlug(s)}
              name={s.name ?? 'Untitled'}
              tagLine={s.tagLine ?? s.description}
              durationMinutes={getDuration(s)}
              price={formatPrice(s)}
              imageUrl={s.media?.mainMedia?.image?.url ?? s.media?.items?.[0]?.image?.url}
              type={s.type ?? 'APPOINTMENT'}
            />
          ))}
        </div>
      )
    }
    <div class="flex flex-wrap gap-md items-center">
      <a href="/services/free-site-survey" class="btn-primary">Book free site survey</a>
      <a href="/services" class="btn-secondary">View all services</a>
    </div>
  </section>
  <section class="max-w-6xl mx-auto px-lg py-4xl grid grid-cols-1 md:grid-cols-2 gap-3xl items-center">
    <div
      class="about-image rounded-md order-last md:order-first"
      data-decorative-slot="about"
      style="aspect-ratio: 4/3; background-color: var(--color-paper-warm);"
    >
      <!-- orchestrator injects <img src={decorativeImages.about} …> here -->
    </div>
    <div class="flex flex-col gap-md max-w-prose">
      <hr class="editorial-rule w-16 ml-0" />
      <h2 class="font-display text-3xl leading-tight">The story behind Saanvika Solar Systems</h2>
      <p class="text-ink leading-relaxed">
        A short, brand-contextual paragraph about what makes Saanvika Solar Systems distinct.
      </p>
      <p class="text-mute leading-relaxed">
        A second paragraph adding warmth and detail to the brand story.
      </p>
    </div>
  </section>
</Layout>
